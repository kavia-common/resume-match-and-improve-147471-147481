# Frontend environment variables
# API base URL (e.g., http://localhost:3001 or backend service URL)
REACT_APP_API_BASE_URL=http://localhost:3001

# Supabase project URL and anon key
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Optional: public site URL for Supabase email redirect (defaults to window.location.origin if not provided)
REACT_APP_SITE_URL=
